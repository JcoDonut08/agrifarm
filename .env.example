APP_NAME=AgriFarm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_OTP_EXPIRES_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_RESEND_MAX_PER_HOUR=5

ACCOUNT_OTP_EXPIRES_MINUTES=10
ACCOUNT_OTP_MAX_ATTEMPTS=5
ACCOUNT_OTP_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_OTP_RESEND_MAX_PER_HOUR=5

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=agrifarm
DB_TIMEZONE=+00:00
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-agri-email@gmail.com"
MAIL_PASSWORD="your-16-character-google-app-password"
MAIL_FROM_ADDRESS="your-agri-email@gmail.com"
MAIL_FROM_NAME="AgriFarm Marketplace"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Open-Meteo needs no API key for the non-commercial academic prototype.
OPEN_METEO_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_LOCATION="Pasig City"
OPEN_METEO_LATITUDE=14.5764
OPEN_METEO_LONGITUDE=121.0851
OPEN_METEO_TIMEZONE=Asia/Manila
OPEN_METEO_CACHE_MINUTES=30
OPEN_METEO_STALE_HOURS=6

# Google Weather is the primary dashboard provider when enabled and configured.
# Keep this key server-side; never add it to a VITE_ variable.
GOOGLE_WEATHER_ENABLED=false
GOOGLE_WEATHER_API_KEY=
GOOGLE_WEATHER_BASE_URL=https://weather.googleapis.com
GOOGLE_WEATHER_LOCATION="Pasig City"
GOOGLE_WEATHER_LATITUDE=14.5764
GOOGLE_WEATHER_LONGITUDE=121.0851
GOOGLE_WEATHER_TIMEZONE=Asia/Manila
GOOGLE_WEATHER_CACHE_MINUTES=30
GOOGLE_WEATHER_STALE_MINUTES=60

VITE_APP_NAME="${APP_NAME}"

# Optional admin contact inbox; defaults to MAIL_FROM_ADDRESS when unset.
# CONTACT_EMAIL=your-agri-email@gmail.com
